 pub(crate) use fetch::{fetch_ocsp_response, fetch_ocsp_response_async};
 
+/// Status result from checking a certificate's live OCSP revocation status.
+#[derive(serde::Serialize, serde::Deserialize, Debug, Clone)]
+pub struct CertificateOcspStatus {
+    /// Revocation status: "good", "revoked", "unknown", "inaccessible", "no_responder", "untrusted_root", "root_ca".
+    pub status: String,
+    /// AIA OCSP responder URL.
+    pub responder_url: Option<String>,
+    /// Serial number of the checked certificate.
+    pub serial_number: Option<String>,
+    /// The thisUpdate timestamp from the OCSP response.
+    pub this_update: Option<String>,
+    /// The nextUpdate timestamp from the OCSP response.
+    pub next_update: Option<String>,
+    /// The revokedAt timestamp if revoked.
+    pub revoked_at: Option<String>,
+    /// The revocation reason if revoked.
+    pub revocation_reason: Option<String>,
+}
+
+/// Check live OCSP revocation status for a certificate given its DER and issuer's DER.
+pub async fn check_certificate_ocsp(
+    cert_der: &[u8],
+    issuer_der: &[u8],
+    context: &crate::Context,
+) -> CertificateOcspStatus {
+    let (_rem, cert) = match x509_parser::certificate::X509Certificate::from_der(cert_der) {
+        Ok(res) => res,
+        Err(_) => {
+            return CertificateOcspStatus {
+                status: "invalid_cert".to_string(),
+                responder_url: None,
+                serial_number: None,
+                this_update: None,
+                next_update: None,
+                revoked_at: None,
+                revocation_reason: None,
+            };
+        }
+    };
+
+    let serial_num = cert.serial.to_string();
+    let responders = fetch::extract_aia_responders(&cert).unwrap_or_default();
+    if responders.is_empty() {
+        return CertificateOcspStatus {
+            status: "no_responder".to_string(),
+            responder_url: None,
+            serial_number: Some(serial_num),
+            this_update: None,
+            next_update: None,
+            revoked_at: None,
+            revocation_reason: None,
+        };
+    }
+
+    let responder_url = responders[0].clone();
+    let certs = vec![cert_der.to_vec(), issuer_der.to_vec()];
+
+    let ocsp_rsp = match fetch::fetch_ocsp_response_async(&certs, 0, context).await {
+        Some(rsp) => rsp,
+        None => {
+            return CertificateOcspStatus {
+                status: "inaccessible".to_string(),
+                responder_url: Some(responder_url),
+                serial_number: Some(serial_num),
+                this_update: None,
+                next_update: None,
+                revoked_at: None,
+                revocation_reason: None,
+            };
+        }
+    };
+
+    let Ok(ocsp_response) = rasn::der::decode::<rasn_ocsp::OcspResponse>(&ocsp_rsp) else {
+        return CertificateOcspStatus {
+            status: "unknown".to_string(),
+            responder_url: Some(responder_url),
+            serial_number: Some(serial_num),
+            this_update: None,
+            next_update: None,
+            revoked_at: None,
+            revocation_reason: None,
+        };
+    };
+
+    if ocsp_response.status != rasn_ocsp::OcspResponseStatus::Successful {
+        return CertificateOcspStatus {
+            status: "unknown".to_string(),
+            responder_url: Some(responder_url),
+            serial_number: Some(serial_num),
+            this_update: None,
+            next_update: None,
+            revoked_at: None,
+            revocation_reason: None,
+        };
+    }
+
+    let Some(response_bytes) = ocsp_response.bytes else {
+        return CertificateOcspStatus {
+            status: "unknown".to_string(),
+            responder_url: Some(responder_url),
+            serial_number: Some(serial_num),
+            this_update: None,
+            next_update: None,
+            revoked_at: None,
+            revocation_reason: None,
+        };
+    };
+
+    let Ok(basic_response) = rasn::der::decode::<BasicOcspResponse>(&response_bytes.response) else {
+        return CertificateOcspStatus {
+            status: "unknown".to_string(),
+            responder_url: Some(responder_url),
+            serial_number: Some(serial_num),
+            this_update: None,
+            next_update: None,
+            revoked_at: None,
+            revocation_reason: None,
+        };
+    };
+
+    for single in &basic_response.tbs_response_data.responses {
+        if !cert_id_matches_signer(&single.cert_id, &certs) {
+            continue;
+        }
+
+        let this_up = single.this_update.to_string();
+        let next_up = single.next_update.as_ref().map(|u| u.to_string());
+
+        match &single.cert_status {
+            rasn_ocsp::CertStatus::Good => {
+                return CertificateOcspStatus {
+                    status: "good".to_string(),
+                    responder_url: Some(responder_url),
+                    serial_number: Some(single.cert_id.serial_number.to_string()),
+                    this_update: Some(this_up),
+                    next_update: next_up,
+                    revoked_at: None,
+                    revocation_reason: None,
+                };
+            }
+            rasn_ocsp::CertStatus::Revoked(info) => {
+                let reason = info.revocation_reason.as_ref().map(|r| format!("{r:?}"));
+                return CertificateOcspStatus {
+                    status: "revoked".to_string(),
+                    responder_url: Some(responder_url),
+                    serial_number: Some(single.cert_id.serial_number.to_string()),
+                    this_update: Some(this_up),
+                    next_update: next_up,
+                    revoked_at: Some(info.revocation_time.to_string()),
+                    revocation_reason: reason,
+                };
+            }
+            rasn_ocsp::CertStatus::Unknown(_) => {
+                return CertificateOcspStatus {
+                    status: "unknown".to_string(),
+                    responder_url: Some(responder_url),
+                    serial_number: Some(single.cert_id.serial_number.to_string()),
+                    this_update: Some(this_up),
+                    next_update: next_up,
+                    revoked_at: None,
+                    revocation_reason: None,
+                };
+            }
+        }
+    }
+
+    CertificateOcspStatus {
+        status: "unknown".to_string(),
+        responder_url: Some(responder_url),
+        serial_number: Some(serial_num),
+        this_update: None,
+        next_update: None,
+        revoked_at: None,
+        revocation_reason: None,
+    }
+}
+
+/// Check live OCSP revocation status for an Issuing CA (ICA) certificate in PEM format against root anchors in PEM format.
+pub async fn check_ica_ocsp_pem(
+    ica_pem: &str,
+    roots_pem: &str,
+    context: &crate::Context,
+) -> CertificateOcspStatus {
+    let ica_der = match x509_parser::pem::Pem::iter_from_buffer(ica_pem.as_bytes()).next() {
+        Some(Ok(pem)) => pem.contents,
+        _ => {
+            return CertificateOcspStatus {
+                status: "invalid_ica_pem".to_string(),
+                responder_url: None,
+                serial_number: None,
+                this_update: None,
+                next_update: None,
+                revoked_at: None,
+                revocation_reason: None,
+            };
+        }
+    };
+
+    let (_rem, ica_cert) = match x509_parser::certificate::X509Certificate::from_der(&ica_der) {
+        Ok(res) => res,
+        Err(_) => {
+            return CertificateOcspStatus {
+                status: "invalid_ica_cert".to_string(),
+                responder_url: None,
+                serial_number: None,
+                this_update: None,
+                next_update: None,
+                revoked_at: None,
+                revocation_reason: None,
+            };
+        }
+    };
+
+    // If the certificate is self-signed, it's a root CA, not an ICA.
+    if ica_cert.subject().as_raw() == ica_cert.issuer().as_raw() {
+        return CertificateOcspStatus {
+            status: "root_ca".to_string(),
+            responder_url: None,
+            serial_number: Some(ica_cert.serial.to_string()),
+            this_update: None,
+            next_update: None,
+            revoked_at: None,
+            revocation_reason: None,
+        };
+    }
+
+    let mut matching_root_der = None;
+    for maybe_pem in x509_parser::pem::Pem::iter_from_buffer(roots_pem.as_bytes()) {
+        if let Ok(pem) = maybe_pem {
+            if let Ok((_rem, root_cert)) = x509_parser::certificate::X509Certificate::from_der(&pem.contents) {
+                if root_cert.subject().as_raw() == ica_cert.issuer().as_raw() {
+                    matching_root_der = Some(pem.contents);
+                    break;
+                }
+            }
+        }
+    }
+
+    let Some(root_der) = matching_root_der else {
+        return CertificateOcspStatus {
+            status: "untrusted_root".to_string(),
+            responder_url: None,
+            serial_number: Some(ica_cert.serial.to_string()),
+            this_update: None,
+            next_update: None,
+            revoked_at: None,
+            revocation_reason: None,
+        };
+    };
+
+    check_certificate_ocsp(&ica_der, &root_der, context).await
+}
